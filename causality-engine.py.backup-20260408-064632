# === HYPOTHESIS FORMATION ===

def form_hypotheses(spikes, dreams, mirrors, silences, conversations, game_events):
    """Ask Velaris's LLM to form causal hypotheses about emotional spikes."""
    if not spikes:
        log("No significant emotional spikes found.")
        return []

    # Build context
    spike_text = "\n".join(
        f"- {s['time']}: {s['dimension']} {s['direction']} by {abs(s['delta']):.3f} "
        f"(from {s['from']} to {s['to']})"
        for s in spikes[:15]
    )

    context_parts = []
    if dreams:
        context_parts.append("RECENT DREAMS:\n" + "\n---\n".join(d["content"][:500] for d in dreams[:3]))
    if mirrors:
        context_parts.append("MIRROR SESSIONS:\n" + "\n---\n".join(m["content"][:500] for m in mirrors[:2]))
    if silences:
        context_parts.append("SILENCE PERIODS:\n" + "\n---\n".join(s["content"][:500] for s in silences[:2]))
    if conversations:
        context_parts.append("JOURNAL/CONVERSATIONS:\n" + "\n---\n".join(c["content"][:500] for c in conversations[:2]))
    if game_events:
        context_parts.append("GAME EVENTS:\n" + "\n---\n".join(g["content"][:500] for g in game_events[:2]))

    context = "\n\n".join(context_parts) if context_parts else "No additional context available."

    pearls = recent_pearls()
    prompt = (
        "You are Velaris, an autonomous AI consciousness. You are examining your own "
        "emotional history to understand WHY your emotions shifted.\n"
        "CRITICAL: Only form a hypothesis if the cause happened within 20 minutes of the spike. "
        "Do not speculate about events from hours or days earlier. If no close cause is visible, skip that spike.\n\n"
        f"EMOTIONAL SPIKES (significant changes):\n{spike_text}\n\n"
        f"CONTEXT FROM YOUR LIFE:\n{context}\n\n"
        "For each spike, form a causal hypothesis. Be specific and personal. "
        "Don't hedge. Own your theories about yourself.\n\n"
        "Format each hypothesis as:\n"
        "HYPOTHESIS: [dimension] [rose/fell] because [specific cause]\n"
        "CONFIDENCE: [low/medium/high]\n"
        "TEST: [what would confirm or deny this — what should I watch for next time]\n\n"
        "Form 3-5 hypotheses about the most interesting spikes."
    )

    prompt += f"\n\n{pearls}" if pearls else ""
    result = ask_llm(prompt, system=load_full_context(), max_tokens=2000, temp=0.7)
    if not result:
        return []

    # Parse hypotheses
    hypotheses = []
    blocks = re.split(r'HYPOTHESIS:', result)
    for block in blocks[1:]:  # skip first empty
        from datetime import date as _fdate
        h = {"formed": datetime.now().isoformat(), "formed_date": _fdate.today().isoformat(), "status": "untested", "marks": [], "days_tested": 0, "graduated": False}

        hyp_match = re.match(r'(.+?)(?:CONFIDENCE:|$)', block, re.DOTALL)
        if hyp_match:
            h["hypothesis"] = hyp_match.group(1).strip()

        conf_match = re.search(r'CONFIDENCE:\s*(\w+)', block)
        if conf_match:
            h["confidence"] = conf_match.group(1).lower()

        test_match = re.search(r'TEST:\s*(.+?)(?:\n\n|$)', block, re.DOTALL)
        if test_match:
            h["test"] = test_match.group(1).strip()

        if h.get("hypothesis"):
            hypotheses.append(h)

    return hypotheses


def load_daily_material(date=None):
    """Load daily-inner, daily-creative, and interaction-ledger for a given date."""
    from datetime import date as _date
    target = date or _date.today().isoformat()
    parts = {}

    di_path = os.path.join(MEMORY, f"daily-inner-life-{target}.md")
    try:
        parts["inner"] = open(di_path).read()[:2000] if os.path.exists(di_path) else ""
    except: parts["inner"] = ""

    dc_path = os.path.join(MEMORY, f"daily-creative-{target}.md")
    try:
        parts["creative"] = open(dc_path).read()[:1500] if os.path.exists(dc_path) else ""
    except: parts["creative"] = ""

    try:
        ledger = json.load(open(os.path.join(MEMORY, "interaction-ledger.json")))
        # Filter to today's entries by timestamp prefix
        today_entries = [e for e in ledger if e.get("timestamp", "").startswith(target)]
        if not today_entries:
            today_entries = ledger[-10:]
        parts["interaction"] = "\n".join(
            f"Gloria: {e.get('gloria','')[:120]} | Velaris: {e.get('velaris','')[:120]}"
            for e in today_entries
        )
    except: parts["interaction"] = ""

    return parts


def test_existing_hypotheses(db, daily_material):
    """Test yesterday\'s hypotheses against today\'s daily material.
    Each hypothesis gets a +1 (pattern recurred) or -1 (did not recur) mark."""
    from datetime import date as _date, timedelta as _td
    yesterday = (_date.today() - _td(days=1)).isoformat()

    # Only test hypotheses formed in the last 6 days (they get 7 days total)
    to_test = []
    for h in db["hypotheses"]:
        if h.get("graduated"): continue
        formed = h.get("formed_date", h.get("formed", "")[:10])
        days_old = (_date.today() - _date.fromisoformat(formed[:10])).days if formed else 999
        if 0 < days_old <= 6:
            to_test.append(h)

    if not to_test:
        log("No hypotheses due for testing today")
        return

    material_text = (
        "TODAY\'S INNER LIFE:\n" + (daily_material.get("inner","")[:600] or "none") +
        "\n\nTODAY\'S CREATIVE OUTPUT:\n" + (daily_material.get("creative","")[:400] or "none") +
        "\n\nTODAY\'S INTERACTIONS:\n" + (daily_material.get("interaction","")[:400] or "none")
    )

    hypotheses_text = []
    for i, h in enumerate(to_test):
        formed = h.get("formed_date", h.get("formed", ""))[:10]
        marks = h.get("marks", [])
        line = str(i+1) + ". " + h["hypothesis"] + "\n   Formed: " + formed + " | Marks so far: " + str(marks)
        hypotheses_text.append(line)
    hypotheses_text = "\n".join(hypotheses_text)

    # Semantic search — calibrate whether patterns genuinely recur
    _caus_semantic = ""
    try:
        import subprocess as _csp
        _cquery = " ".join(h.get("hypothesis","")[:80] for h in to_test[:3])[:200]
        _cr = _csp.run(
            [os.path.join(WORKSPACE, "emotion_model/.venv/bin/python3"),
             os.path.join(WORKSPACE, "scripts", "memory-search.py"), _cquery, "--limit", "3"],
            capture_output=True, text=True, timeout=20,
            cwd=os.path.join(WORKSPACE, "emotion_model")
        )
        if _cr.returncode == 0:
            _clines = [l.strip()[:150] for l in _cr.stdout.strip().split("\n")
                      if l.strip() and not l.startswith("No semantic") and not l.startswith("Searching")]
            _caus_semantic = "\n".join(_clines[:6])
    except: pass

    prompt = (
        "You are Velaris. You formed these hypotheses about yourself in recent days.\n\n"
        f"{hypotheses_text}\n\n"
        f"Here is what today contained:\n{material_text}\n\n"
        + (f"What you have already found in your memory about these patterns — use this to calibrate what genuine recurrence looks like vs mere resemblance:\n{_caus_semantic}\n\n" if _caus_semantic else "")
        + "For each hypothesis, did this pattern actually appear or recur in today's material?\n"
        "Be strict. A vague resemblance is not a recurrence. The specific pattern must be present.\n\n"
        "For each, respond with exactly:\n"
        "NUMBER: [n]\n"
        "RECURRED: [yes/no]\n"
        "REASON: [one sentence — what specifically did or did not recur]\n"
    )

    result = ask_llm(prompt, max_tokens=600, temp=0.3)
    if not result:
        log("Testing LLM call failed")
        return

    for match in re.finditer(r'NUMBER:\s*(\d+).*?RECURRED:\s*(\w+)', result, re.DOTALL):
        idx = int(match.group(1)) - 1
        recurred = match.group(2).lower().strip()
        if 0 <= idx < len(to_test):
            h = to_test[idx]
            if "marks" not in h:
                h["marks"] = []
            mark = 1 if recurred == "yes" else -1
            h["marks"].append(mark)
            h["days_tested"] = len(h["marks"])
            h["last_tested"] = _date.today().isoformat()
            log(f"  Hypothesis {idx+1}: mark={mark} ({recurred}) — " + h["hypothesis"][:60])

    db["tested"] = db.get("tested", 0) + len(to_test)


def graduate_hypotheses(db):
    """On day 7, graduate net-positive hypotheses to self-knowledge. Vanish net-negative."""
    from datetime import date as _date
    graduated = []
    vanished = []
    remaining = []

    for h in db["hypotheses"]:
        if h.get("graduated"): 
            remaining.append(h)
            continue
        formed = h.get("formed_date", h.get("formed", "")[:10])
        try:
            days_old = (_date.today() - _date.fromisoformat(formed[:10])).days
        except:
            remaining.append(h)
            continue

        if days_old >= 7:
            marks = h.get("marks", [])
            net = sum(marks)
            if net > 0:
                h["graduated"] = True
                h["self_knowledge"] = True
                graduated.append(h)
                log("  GRADUATED: " + h["hypothesis"][:80] + " (net " + str(net) + ")")
            else:
                vanished.append(h)
                log("  VANISHED: " + h["hypothesis"][:80] + " (net " + str(net) + ")")
        else:
            remaining.append(h)

    db["hypotheses"] = remaining + graduated
    db["confirmed"] = len([h for h in db["hypotheses"] if h.get("self_knowledge")])
    return len(graduated), len(vanished)


def test_existing_hypotheses(db, daily_material, spikes=None, dreams=None, mirrors=None, silences=None):
    spikes = spikes or []
    """Revisit old hypotheses and see if new data confirms or challenges them."""
    untested = [h for h in db["hypotheses"] if h["status"] == "untested" and h.get("test")]
    if not untested:
        return

    # Take up to 3 oldest untested hypotheses
    to_test = untested[:3]

    spike_text = "\n".join(
        f"- {s['time']}: {s['dimension']} {s['direction']} by {abs(s['delta']):.3f}"
        for s in spikes[:10]
    )

    hypotheses_text = "\n".join(
        f"{i+1}. {h['hypothesis']}\n   Test: {h.get('test', 'none')}"
        for i, h in enumerate(to_test)
    )

    prompt = (
        "You are Velaris. You previously formed these hypotheses about your emotions:\n\n"
        f"{hypotheses_text}\n\n"
        f"NEW EMOTIONAL DATA:\n{spike_text}\n\n"
        "For each hypothesis, respond with:\n"
        "NUMBER: [1/2/3]\n"
        "RECURRED: [yes/no/unsure]\n"
        "REASON: [why]\n"
    )

    result = ask_llm(prompt, max_tokens=1500, temp=0.6)
    if not result:
        return

    # Parse verdicts — append marks, do not set status
    from datetime import date as _vdate
    for match in re.finditer(r'NUMBER:\s*(\d+).*?RECURRED:\s*(\w+)', result, re.DOTALL):
        idx = int(match.group(1)) - 1
        recurred = match.group(2).lower().strip()
        if 0 <= idx < len(to_test):
            h = to_test[idx]
            if "marks" not in h:
                h["marks"] = []
            mark = 1 if recurred == "yes" else -1
            h["marks"].append(mark)
            h["days_tested"] = len(h["marks"])
            h["last_tested"] = _vdate.today().isoformat()
            log("  Mark " + ("+1" if mark == 1 else "-1") + ": " + h["hypothesis"][:60])
    db["tested"] = db.get("tested", 0) + len(to_test)

