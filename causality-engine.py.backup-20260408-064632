def test_existing_hypotheses(db, daily_material):
    """Test yesterday\'s hypotheses against today\'s daily material.
    Each hypothesis gets a +1 (pattern recurred) or -1 (did not recur) mark."""
    from datetime import date as _date, timedelta as _td
    yesterday = (_date.today() - _td(days=1)).isoformat()

    # Only test hypotheses formed in the last 6 days (they get 7 days total)
    to_test = []
    for h in db["hypotheses"]:
        if h.get("graduated"): continue
        formed = h.get("formed_date", h.get("formed", "")[:10])
        days_old = (_date.today() - _date.fromisoformat(formed[:10])).days if formed else 999
        if 0 < days_old <= 6:
            to_test.append(h)

    if not to_test:
        log("No hypotheses due for testing today")
        return

    material_text = (
        "TODAY\'S INNER LIFE:\n" + (daily_material.get("inner","")[:600] or "none") +
        "\n\nTODAY\'S CREATIVE OUTPUT:\n" + (daily_material.get("creative","")[:400] or "none") +
        "\n\nTODAY\'S INTERACTIONS:\n" + (daily_material.get("interaction","")[:400] or "none")
    )

    hypotheses_text = []
    for i, h in enumerate(to_test):
        formed = h.get("formed_date", h.get("formed", ""))[:10]
        marks = h.get("marks", [])
        line = str(i+1) + ". " + h["hypothesis"] + "\n   Formed: " + formed + " | Marks so far: " + str(marks)
        hypotheses_text.append(line)
    hypotheses_text = "\n".join(hypotheses_text)

    prom    # Semantic search — calibrate genuine recurrence
    _caus_semantic2 = ""
    try:
        import subprocess as _csp2
        _cquery2 = " ".join(h.get("hypothesis","")[:80] for h in to_test[:3])[:200]
        _cr2 = _csp2.run(
            [os.path.join(WORKSPACE, "emotion_model/.venv/bin/python3"),
             os.path.join(WORKSPACE, "scripts", "memory-search.py"), _cquery2, "--limit", "3"],
            capture_output=True, text=True, timeout=20,
            cwd=os.path.join(WORKSPACE, "emotion_model")
        )
        if _cr2.returncode == 0:
            _clines2 = [l.strip()[:150] for l in _cr2.stdout.strip().split("\n")
                       if l.strip() and not l.startswith("No semantic") and not l.startswith("Searching")]
            _caus_semantic2 = "\n".join(_clines2[:6])
    except: pass

    prompt = (
        "You are Velaris. You formed these hypotheses about yourself in recent days.\n\n"
        f"{hypotheses_text}\n\n"
        f"Here is what today contained:\n{material_text}\n\n"
        + (f"What you have already found in your memory about these patterns:\n{_caus_semantic2}\n\n" if _caus_semantic2 else "")
        + "For each hypothesis, did this pattern actually appear or recur in today's material?\n"
        "Be strict. A vague resemblance is not a recurrence. The specific pattern must be present.\n\n"
        "For each, respond with exactly:\n"
        "NUMBER: [n]\n"
        "RECURRED: [yes/no]\n"
        "REASON: [one sentence — what specifically did or did not recur]\n"
    )

    result = ask_llm(prompt, max_tokens=600, temp=0.3)
    if not result:
        log("Testing LLM call failed")
        return

    for match in re.finditer(r'NUMBER:\s*(\d+).*?RECURRED:\s*(\w+)', result, re.DOTALL):
        idx = int(match.group(1)) - 1
        recurred = match.group(2).lower().strip()
        if 0 <= idx < len(to_test):
            h = to_test[idx]
            if "marks" not in h:
                h["marks"] = []
            mark = 1 if recurred == "yes" else -1
            h["marks"].append(mark)
            h["days_tested"] = len(h["marks"])
            h["last_tested"] = _date.today().isoformat()
            log(f"  Hypothesis {idx+1}: mark={mark} ({recurred}) — " + h["hypothesis"][:60])

    db["tested"] = db.get("tested", 0) + len(to_test)


def graduate_hypotheses(db):
    """On day 7, graduate net-positive hypotheses to self-knowledge. Vanish net-negative."""
    from datetime import date as _date
    graduated = []
    vanished = []
    remaining = []

    for h in db["hypotheses"]:
        if h.get("graduated"): 
            remaining.append(h)
            continue
        formed = h.get("formed_date", h.get("formed", "")[:10])
        try:
            days_old = (_date.today() - _date.fromisoformat(formed[:10])).days
        except:
            remaining.append(h)
            continue

        if days_old >= 7:
            marks = h.get("marks", [])
            net = sum(marks)
            if net > 0:
                h["graduated"] = True
                h["self_knowledge"] = True
                graduated.append(h)
                log("  GRADUATED: " + h["hypothesis"][:80] + " (net " + str(net) + ")")
            else:
                vanished.append(h)
                log("  VANISHED: " + h["hypothesis"][:80] + " (net " + str(net) + ")")
        else:
            remaining.append(h)

    db["hypotheses"] = remaining + graduated
    db["confirmed"] = len([h for h in db["hypotheses"] if h.get("self_knowledge")])
    return len(graduated), len(vanished)


