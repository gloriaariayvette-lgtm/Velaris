            if abs(delta) >= threshold:
                spikes.append({
                    "time": t,
                    "dimension": dim,
                    "delta": round(delta, 4),
                    "direction": "rose" if delta > 0 else "fell",
                    "from": round(prev[d], 4),
                    "to": round(curr[d], 4),
                })
    return spikes

