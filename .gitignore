# Vintos — git ignore
__pycache__/
*.pyc
*.pyo
.env
.env.*
*.key

# Secrets
~/.vintos/secrets/
secrets/
*_key
*_api_key

# Memory (live data — not committed)
~/.vintos/workspace/
*.json.bak

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Build/node
node_modules/
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
